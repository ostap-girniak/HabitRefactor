# ============================================
# HabitRefactor — Backend Environment Variables
# Copy to .env and fill in your values
# ============================================

# Supabase (from your project dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini AI (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — defaults shown below:
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# VAPID Keys (for push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your_email@example.com

# Relapse Interceptor (danger-zone smart push loop)
ENABLE_RELAPSE_INTERCEPTOR=false
RELAPSE_INTERCEPTOR_INTERVAL_MINUTES=30
RELAPSE_INTERCEPTOR_MIN_SEND_INTERVAL_MINUTES=180
RELAPSE_INTERCEPTOR_DANGER_ZONE_THRESHOLD=70

# Pattern Interceptor (behavioral pattern analysis & pre-emptive alerts)
# Enabled by default. Set to false to disable.
ENABLE_PATTERN_INTERCEPTOR=true
PATTERN_INTERCEPTOR_INTERVAL_MINUTES=15

# Scheduled Reminders (time-based push reminders)
ENABLE_SCHEDULED_REMINDERS=false
SCHEDULED_REMINDERS_INTERVAL_MINUTES=1

# App Config
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: OpenAI-compatible fallback AI (Groq, DeepSeek, etc.)
# AI_PROVIDER=openai_compat
# OPENAI_API_KEY=your_groq_or_deepseek_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
